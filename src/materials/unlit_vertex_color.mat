material {
    name : unlit_vertex_color,
    shadingModel : unlit,
    requires : [ color ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // P37: Match Cesium benchmark CustomShader:
        // material.diffuse = pow(material.diffuse, vec3(2.2)).
        // COLOR_0 vertex colors (pnts) are sRGB; convert to linear.
        material.baseColor.rgb = pow(getColor().rgb, vec3(2.2));
    }
}
