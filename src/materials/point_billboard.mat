material {
    name : point_billboard,
    shadingModel : unlit,
    requires : [ color, uv0 ],
    culling : none
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // P37: Billboard quad offset in world space.
        // Positions are rebased to local origin (small values), so
        // world-space XY offset approximates view-plane offset for
        // the test camera. Standard implementations use camera basis.
        vec2 corner = material.uv0 * 2.0 - 1.0; // [0,1] -> [-1,1]
        const float pointSize = 0.007;
        material.worldPosition.xy += corner * pointSize;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor.rgb = getColor().rgb;
    }
}
