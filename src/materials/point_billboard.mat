material {
    name : point_billboard,
    shadingModel : unlit,
    requires : [ color, uv0 ],
    culling : none
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        vec2 corner = material.uv0 * 2.0 - 1.0;
        const float pointSize = 0.007;
        material.worldPosition.xy += corner * pointSize;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor.rgb = getColor().rgb;
    }
}
