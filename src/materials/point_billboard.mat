material {
    name : point_billboard,
    shadingModel : unlit,
    requires : [ color, uv0 ],
    culling : none
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // P37: Standard billboard. Positions are in world space;
        // offset along view-plane XY (camera looks along -Z in view space,
        // but worldPosition is world space - use small fixed offset).
        // TODO: Use cameraRight/cameraUp from view matrix for correctness.
        vec2 corner = material.uv0 * 2.0 - 1.0; // [0,1] -> [-1,1]
        const float pointSize = 0.007;
        material.worldPosition.xy += corner * pointSize;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor.rgb = getColor().rgb;
    }
}
