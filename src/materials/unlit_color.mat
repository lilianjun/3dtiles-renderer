material {
    name : unlit_color,
    shadingModel : unlit,
    parameters : [
        { type : float3, name : color }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // P37: baseColorFactor is converted to linear in converter.
        // Cesium UNLIT outputs sRGB (linearToSrgb at end).
        // Encode linear->sRGB here to match.
        vec3 linear = materialParams.color;
        vec3 srgb = mix(linear * 12.92,
                        1.055 * pow(linear, vec3(1.0/2.4)) - 0.055,
                        step(0.0031308, linear));
        material.baseColor.rgb = srgb;
    }
}
