material {
    name : unlit_color,
    shadingModel : unlit,
    parameters : [
        { type : float3, name : color }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // P37: Match Cesium benchmark CustomShader:
        // material.diffuse = pow(material.diffuse, vec3(2.2)).
        // baseColorFactor is sRGB; convert to linear.
        material.baseColor.rgb = pow(materialParams.color, vec3(2.2));
    }
}
