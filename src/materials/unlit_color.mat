material {
    name : unlit_color,
    shadingModel : unlit,
    parameters : [
        { type : float3, name : color }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // P37: baseColorFactor from Cesium Native is already linear
        // (srgbToLinear applied in converter). Output directly.
        material.baseColor.rgb = materialParams.color;
    }
}
