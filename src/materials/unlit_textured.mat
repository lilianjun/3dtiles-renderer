material {
    name : unlit_textured,
    shadingModel : unlit,
    parameters : [
        { type : float3, name : color },
        { type : sampler2d, name : baseColorMap }
    ],
    requires : [
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 tex = texture(materialParams_baseColorMap, getUV0());
        // P37: Texture is SRGB8_A8, HW decodes sRGB->linear. Cesium UNLIT
        // does linearToSrgb at output, so convert back here.
        // (2026-10-08: was outputting linear directly -> dark, e.g. 91 vs 157)
        vec3 srgbTex = pow(tex.rgb, vec3(1.0 / 2.2));
        material.baseColor.rgb = srgbTex * materialParams.color;
        material.baseColor.a = tex.a * materialParams.color.b;
    }
}
