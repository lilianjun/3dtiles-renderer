material {
    name : unlit_textured,
    shadingModel : unlit,
    parameters : [
        { type : float3, name : color },
        { type : sampler2d, name : baseColorMap }
    ],
    requires : [
        uv0
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 tex = texture(materialParams_baseColorMap, getUV0());
        // P37: Texture is SRGB8_ALPHA8, hardware already decoded sRGB->linear.
        // Do NOT pow() here (would double-convert).
        material.baseColor.rgb = tex.rgb * materialParams.color;
        material.baseColor.a = tex.a * materialParams.color.b;
    }
}
